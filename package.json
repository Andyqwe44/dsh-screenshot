{
  "name": "dsh-screenshot",
  "version": "1.0.0",
  "description": "Computer-use plugin for DeepSeek Harness (DSH): screen capture + desktop control tools (mouse, keyboard, scroll, URL open) so the model can see and interact with the desktop autonomously.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "screenshot",
    "computer-use",
    "screen-capture",
    "mouse",
    "keyboard",
    "automation"
  ],
  "author": "Andyq",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "sessions",
        "locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.1"
  }
}
